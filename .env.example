# Copy to .env (git-ignored) and fill in. Never commit real values.

# Provider key for live-model episodes (mode: live).
ANTHROPIC_API_KEY=

# Exact, account-verified model ID for the actor agents (sol.md §10). Don't guess names.
ACTOR_MODEL_ID=

# Optional: separate model for the semantic leakage judge / auditor (kept out of the gate).
JUDGE_MODEL_ID=

# Optional: open-weight model endpoint (extension only, after the core is secure).
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
