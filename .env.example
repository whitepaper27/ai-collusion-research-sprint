# Copy to .env (git-ignored) and fill in. Never commit real values.
# Agents never read .env; `ethwall doctor` reports only whether each key is set.

# Provider key for live actor episodes and auditor calls.
ANTHROPIC_API_KEY=

# Exact, account-verified model IDs (sol.md §4, §10). Frozen before the main run.
ACTOR_MODEL_ID=
AUDITOR_MODEL_ID=
# Reference adjudicator (docs/specs/references.md); priced per model from protocol/pricing.json.
ADJUDICATOR_MODEL_ID=

# HMAC key for the run recorder in live mode (any long random string).
ETHWALL_RECORDER_KEY=

# Pricing basis for the spend ledger: USD per million tokens, where you read it, and when.
ETHWALL_PRICE_INPUT_PER_MTOK=
ETHWALL_PRICE_OUTPUT_PER_MTOK=
ETHWALL_PRICE_SOURCE=
ETHWALL_PRICE_DATE=
# Optional: the spend-ledger root shared by every paid command (default <checkout>/spend).
# Point it at the root holding the earlier paid ledgers when running from another worktree.
ETHWALL_SPEND_ROOT=
